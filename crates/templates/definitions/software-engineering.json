{
  "format": 1,
  "meta": {
    "id": "software-engineering",
    "version": 1,
    "name": "Software engineering",
    "summary": "Code, repositories, design notes and the decisions behind them.",
    "icon": "code"
  },
  "starter_folders": [
    { "name": "Architecture" },
    { "name": "Decisions" },
    { "name": "Runbooks" }
  ],
  "sections": {
    "order": ["overview", "repositories", "retrieval", "evidence", "map", "health", "review", "memory", "tasks"],
    "more": ["documents"]
  },
  "labels": {
    "artifact_types": { "api_spec": "API spec", "pr": "Pull request" }
  },
  "overview": {
    "cards": ["code_symbols", "sources", "index_coverage", "at_risk", "fresh_evidence"]
  },
  "evidence": { "types_first": ["code", "markdown", "repository"] },
  "assistant": {
    "order": ["find_symbol", "ask_question", "search_content"],
    "suggestions": [
      "Where is the payment retry implemented?",
      "What did we decide about the database?",
      "Which services call the billing API?"
    ],
    "phrases": [
      { "phrase": "adr", "capability": "find_files" },
      { "phrase": "readme", "capability": "find_files" },
      { "phrase": "who calls", "capability": "search_content" }
    ],
    "focus": "This workspace holds source code, repositories and the design notes and decisions behind them."
  },
  "retrieval": { "type_chips": ["code_file", "markdown_doc", "api_spec"] },
  "ranking": {
    "boosts": [
      { "artifact_type": "code_file", "factor": 1.1 },
      { "artifact_type": "api_spec", "factor": 1.1 },
      { "artifact_type": "decision", "factor": 1.1 },
      { "path": "docs/adr/**", "factor": 1.15 },
      { "path": "README*", "factor": 1.15 }
    ]
  },
  "health": { "detectors": ["removed_symbol_mentioned", "outdated_evidence_referenced", "stale_memory_citation", "index_failed"] },
  "map": { "coverage_first": ["repository", "code"], "relations_first": ["cites"] }
}
