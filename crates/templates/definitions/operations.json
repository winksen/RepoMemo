{
  "format": 1,
  "meta": {
    "id": "operations",
    "version": 1,
    "name": "Operations and incidents",
    "summary": "Runbooks, incidents, postmortems and on-call knowledge.",
    "icon": "heartbeat"
  },
  "starter_folders": [
    { "name": "Runbooks" },
    { "name": "Incidents" },
    { "name": "Postmortems" },
    { "name": "On-call" }
  ],
  "sections": {
    "order": ["overview", "evidence", "review", "health", "retrieval", "tasks", "memory"],
    "more": ["map", "repositories", "documents"],
    "landing": "review"
  },
  "labels": {
    "sections": { "evidence": "Runbooks and incidents", "tasks": "Actions", "memory": "Lessons" }
  },
  "overview": {
    "cards": ["fresh_evidence", "active_tasks", "at_risk", "memory_cards"],
    "headline": "active_tasks"
  },
  "evidence": { "default_view": "list", "types_first": ["markdown", "note", "text"] },
  "assistant": {
    "order": ["ask_question", "search_content", "find_files"],
    "suggestions": [
      "What is the runbook for…",
      "What happened in the last incident?",
      "Who is on call for…",
      "What are the steps to roll back…"
    ],
    "phrases": [
      { "phrase": "runbook", "capability": "find_files" },
      { "phrase": "postmortem", "capability": "find_files" },
      { "phrase": "on-call", "capability": "find_files" },
      { "phrase": "incident", "capability": "search_content" }
    ],
    "focus": "This workspace holds runbooks, incident reports and on-call knowledge for running a service."
  },
  "retrieval": { "type_chips": ["runbook", "incident", "note"] },
  "ranking": {
    "verified": 1.15,
    "boosts": [
      { "artifact_type": "runbook", "factor": 1.2 },
      { "artifact_type": "incident", "factor": 1.2 }
    ],
    "recency": { "half_life_days": 90, "max_factor": 1.2 }
  },
  "health": { "detectors": ["stale_evidence", "outdated_evidence_referenced", "stale_memory_citation", "index_failed"], "stale_after_days": 90 },
  "review": { "order": ["health_finding", "evidence", "memory_card"] },
  "map": { "coverage_first": ["markdown", "note", "text"], "relations_first": ["cites"] },
  "repositories": { "exclude": ["*.tfstate", "*.tfstate.backup", "*.log"] }
}
