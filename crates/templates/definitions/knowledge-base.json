{
  "format": 1,
  "meta": {
    "id": "knowledge-base",
    "version": 1,
    "name": "Knowledge base",
    "summary": "Policies, contracts, reports and other business documents.",
    "icon": "book"
  },
  "starter_folders": [
    { "name": "Policies" },
    { "name": "Contracts" },
    { "name": "Reports" },
    { "name": "Archive" }
  ],
  "sections": {
    "order": ["overview", "documents", "retrieval", "evidence", "review", "health", "memory", "tasks"],
    "more": ["map", "repositories"],
    "landing": "documents"
  },
  "labels": {
    "sections": { "evidence": "Library" }
  },
  "overview": {
    "cards": ["index_coverage", "indexed_storage", "fresh_evidence", "knowledge_density"],
    "headline": "sources"
  },
  "evidence": { "default_view": "list", "types_first": ["word", "pdf", "excel", "powerpoint"] },
  "assistant": {
    "order": ["find_files", "ask_question", "summarize_file"],
    "suggestions": [
      "Which contracts mention…",
      "What does our policy say about…",
      "Find the latest report on…"
    ],
    "phrases": [
      { "phrase": "policy", "capability": "find_files" },
      { "phrase": "contract", "capability": "find_files" },
      { "phrase": "report on", "capability": "find_files" }
    ],
    "focus": "This workspace holds policies, contracts, reports and other business documents."
  },
  "retrieval": { "type_chips": ["file", "markdown_doc"] },
  "ranking": {
    "verified": 1.15,
    "boosts": [
      { "document_kind": "word", "factor": 1.15 },
      { "document_kind": "pdf", "factor": 1.15 },
      { "document_kind": "excel", "factor": 1.15 },
      { "document_kind": "powerpoint", "factor": 1.15 }
    ]
  },
  "health": { "detectors": ["older_version_active", "duplicate_content", "stale_evidence", "outdated_evidence_referenced", "index_failed"], "stale_after_days": 180 },
  "review": { "order": ["evidence", "memory_card", "health_finding"] },
  "map": { "coverage_first": ["word", "pdf", "excel", "powerpoint"], "relations_first": ["similar"] },
  "repositories": { "include": ["**/*.pdf", "**/*.docx", "**/*.xlsx", "**/*.pptx", "**/*.md"] }
}
