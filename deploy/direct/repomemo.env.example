# The settings of a direct install (V0.4.31): RepoMemo as one program on a server, with no container. Copy this file to
# repomemo.env, fill in the secrets and give it to the service (the systemd unit reads it, V0.4.32; the Windows service
# reads it, V0.4.33). Every setting is described in docs/DEVELOPMENT_COMMANDS.md and the guide is
# mindmap/technical/operations.md.
#
# Paths below are for Linux (/opt/repomemo is where the archive is unpacked, /var/lib/repomemo is the working folder);
# on Windows use C:\Program Files\RepoMemo and C:\ProgramData\RepoMemo.

# Where the server listens. Behind a front door on the same machine, keep the loopback; the front door brings TLS.
REPOMEMO_SERVER_ADDR=127.0.0.1:3020

# The address people use. With https:// the server sends HSTS and sets secure cookies.
REPOMEMO_PUBLIC_URL=https://memo.example.com
REPOMEMO_ALLOWED_ORIGIN=https://memo.example.com
REPOMEMO_TRUST_PROXY=true

# The data lives in workspace-data/main under the working folder.
REPOMEMO_SERVER_DATA_DIR=main

# The built web app that ships in the archive: the server serves it itself on the same port (V0.4.20).
REPOMEMO_WEB_DIR=/opt/repomemo/web

# Required: 32 or more random characters each (openssl rand -hex 32). Keep a copy of the secret key.
# A secret can be a file instead (REPOMEMO_JWT_SECRET_FILE=/etc/repomemo/jwt), never both.
REPOMEMO_JWT_SECRET=
REPOMEMO_SECRET_KEY=

# Optional: a code (12 or more letters and digits) for the first-run setup; otherwise one is printed in the log.
REPOMEMO_SETUP_CODE=
