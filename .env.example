# Settings for `docker compose up` (copy this file to .env; .env is not committed).
# Every REPOMEMO_ variable of the server is described in docs/DEVELOPMENT_COMMANDS.md.

# The name people type, such as memo.example.com. It must point at this machine
# and ports 80 and 443 must reach it, so Caddy can get a certificate.
# "localhost" works on this machine only, with a certificate from Caddy's own
# authority that the browser will ask you to trust.
REPOMEMO_HOST=localhost

# The optional pieces to start. `edge` is TLS in front of the web image (a certificate for the name above, Caddy's
# own for localhost, or yours in deploy/certs); leave it out behind a proxy or a load balancer of your own, which
# then reaches the web image on 127.0.0.1:8080 (REPOMEMO_WEB_PORT). Add `previews` for Office previews.
COMPOSE_PROFILES=edge

# Required: 32 or more random characters each. Generate them with
#   openssl rand -base64 48
# Each secret in this file can be a file instead: REPOMEMO_JWT_SECRET_FILE=/run/secrets/jwt (the same for
# REPOMEMO_SECRET_KEY, REPOMEMO_BACKUP_KEY, REPOMEMO_BACKUP_KEY_PREVIOUS and REPOMEMO_SETUP_CODE), never both.
# JWT secret: signs sessions and file links (changing it signs everyone out).
REPOMEMO_JWT_SECRET=
# Secret key: encrypts the AI provider keys and repository tokens in the
# database. Keep a copy somewhere safe; without it they must be entered again.
REPOMEMO_SECRET_KEY=

# Optional.
# Only for deploy/api.yml (the API alone, V0.4.11): the address people use, the web client's origin when it is
# elsewhere, and the loopback port the API is published on.
# REPOMEMO_PUBLIC_URL=https://memo.example.com
# REPOMEMO_ALLOWED_ORIGIN=https://memo.example.com
# REPOMEMO_API_PORT=3020
# A code (12 or more letters and digits) that unlocks the first-run setup. When
# empty, one is printed in the server's log: `docker compose logs server`.
REPOMEMO_SETUP_CODE=
# Addresses promoted to system administrators when the server starts.
REPOMEMO_SYSTEM_ADMIN_EMAILS=
# A backup is made by itself when the newest is older than this many hours (0: off).
REPOMEMO_BACKUP_INTERVAL_HOURS=24
# Seals every backup (16 or more characters). Keep it apart from the backups:
# without it they cannot be restored.
REPOMEMO_BACKUP_KEY=
# When you change the key above, put the old one here until every backup made with it is sealed again (System >
# Backups) or deleted: it opens those backups, and new backups use the new key. Leave it empty otherwise.
REPOMEMO_BACKUP_KEY_PREVIOUS=
# The converter image the previews profile starts, when it is not the one built here: a tag of its own, such as
# repomemo-converter:0.4.12. Leave it empty to build it from the Dockerfile's converter stage.
# REPOMEMO_CONVERTER_IMAGE=
# What the web app is told when it starts: the API's address (empty: this host, the usual case) and the name
# shown in the browser's tab. No quote or backslash in either.
# REPOMEMO_WEB_API_URL=
# REPOMEMO_PRODUCT_NAME=RepoMemo
# Layout-accurate Office previews, off until you turn them on. LibreOffice runs in a container of its own
# (no network, only the previews volume): set COMPOSE_PROFILES=edge,previews as well, and use a LibreOffice at
# 26.2.5 or later, which the server checks at start.
REPOMEMO_OFFICE_PREVIEWS=false

# Which images.
# The release to run: the tag of the images pulled from the registry (for example 0.4.40). Pin one for a server you keep;
# `latest` follows each new release. Built from this checkout instead (docker-compose.build.yml), it is the tag they get.
REPOMEMO_VERSION=latest
# Where the images are pulled from (the default is the project's own); a mirror of your own works the same way.
# REPOMEMO_REGISTRY=ghcr.io/repomemo
