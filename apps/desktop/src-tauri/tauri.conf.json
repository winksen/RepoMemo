{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoMemo",
  "version": "0.4.81",
  "identifier": "com.repomemo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3021",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "RepoMemo",
        "width": 1220,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src blob:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:3021 http://127.0.0.1:3021; frame-src blob:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "RepoMemo",
    "copyright": "Copyright (c) RepoMemo contributors. MIT License.",
    "category": "DeveloperTool",
    "shortDescription": "RepoMemo desktop app",
    "longDescription": "The RepoMemo web client in a window of its own, for a RepoMemo server.",
    "homepage": "https://github.com/repomemo/repomemo",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["xdg-utils"]
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["repomemo"] }
    },
    "updater": {
      "pubkey": "set-at-run-time-by-the-feed-the-app-is-given",
      "endpoints": [],
      "requireSignedVersion": true
    }
  }
}
