{
  "name": "repomemo",
  "version": "0.4.91",
  "private": true,
  "description": "Local-first technical memory workspace for teams.",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @repomemo/desktop run tauri:dev",
    "web:dev": "npm --workspace @repomemo/desktop run dev",
    "build": "npm --workspace @repomemo/desktop run build",
    "icons": "node scripts/create-tauri-icon.mjs",
    "typecheck": "npm --workspace @repomemo/desktop run typecheck",
    "console": "cargo run -q -p repomemo-console --",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/set-version.mjs --check",
    "types:generate": "node scripts/generate-types.mjs",
    "types:check": "node scripts/generate-types.mjs --check",
    "test:web": "npm --workspace @repomemo/desktop run test",
    "backup:drill": "cargo test -p repomemo-server --lib a_backup_restores_into_a_new_environment_that_opens --locked",
    "styles:check": "node scripts/check-styles.mjs",
    "container:check": "node scripts/check-container.mjs",
    "a11y:check": "node scripts/check-accessibility.mjs",
    "migrations:check": "node scripts/check-migrations.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "templates:check": "node scripts/check-templates.mjs",
    "templates:test": "node --test scripts/check-templates.test.mjs",
    "package:server": "node scripts/package-server.mjs",
    "package:test": "node --test scripts/package-server.test.mjs",
    "notes": "node scripts/release-notes.mjs",
    "notes:test": "node --test scripts/release-notes.test.mjs",
    "pins:test": "node --test scripts/pins.test.mjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:test": "node --test scripts/package-desktop.test.mjs",
    "feed:test": "node --test scripts/update-feed.test.mjs",
    "desktop:check": "node scripts/check-desktop.mjs",
    "troubleshooting:check": "node scripts/check-troubleshooting.mjs",
    "troubleshooting:test": "node --test scripts/check-troubleshooting.test.mjs",
    "desktop:parity:test": "node --test scripts/check-desktop.test.mjs"
  },
  "engines": {
    "node": ">=22.12",
    "npm": ">=10"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8"
  }
}
